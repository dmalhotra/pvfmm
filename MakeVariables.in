# Load this file inside your Makefile and use the variables CXXFLAGS_PVFMM and
# LDLIBS_PVFMM for compiling your code. You can use examples/Makefile as a
# template makefile for your projects linking to this library.

INSTALL_DIR_PVFMM = @prefix@
TOP_SRCDIR_PVFMM = @abs_top_srcdir@
PKG_SUBDIR_PVFMM =

# Compiler and flags.
CXX_PVFMM = @MPICXX@
CC_PVFMM = @MPICC@
FC_PVFMM = @MPIFC@

# The PVFMM library and headers.
PVFMM_INCLUDES = -I$(TOP_SRCDIR_PVFMM)/include$(PKG_SUBDIR_PVFMM)
PVFMM_LIBS = -L$(TOP_SRCDIR_PVFMM)/lib$(PKG_SUBDIR_PVFMM) -lpvfmm

# Add FFTW include and lib paths.
FFTW_INCLUDES_PVFMM = @FFTW_INCLUDE@
FFTW_LIBS_PVFMM = @FFTW_LIB@ @FFTWF_LIB@ @FFTWL_LIB@

# BLAS, LAPACK libs.
BLAS_LAPACK_LIB_PVFMM = @LAPACK_LIBS@ @BLAS_LIBS@ @FLIBS@

# nvcc compiler and flags.
NVCC_PVFMM = @NVCC@
NVCCFLAGS_PVFMM = @NVCCFLAGS@ @CUDA_CFLAGS@ $(PVFMM_INCLUDES)

# CUDA include and libs.
CUDA_CFLAGS_PVFMM = @CUDA_CFLAGS@
CUDA_LDLIBS_PVFMM = @CUDA_LDLIBS@

# Add all CXXFLAGS_PVFMM and LDLIBS_PVFMM
CXXFLAGS_PVFMM = @CXXFLAGS@ $(PVFMM_INCLUDES) $(FFTW_INCLUDES_PVFMM) $(CUDA_CFLAGS_PVFMM)

# Optimization / ISA / language standard (assembled by configure; the -O3 here
# overrides the -O2 autoconf puts in @CXXFLAGS@).
CXXFLAGS_PVFMM += @PVFMM_OPT_FLAGS@
LDLIBS_PVFMM = @LDFLAGS@ $(PVFMM_LIBS) $(FFTW_LIBS_PVFMM) $(BLAS_LAPACK_LIB_PVFMM) $(CUDA_LDLIBS_PVFMM) @LIBMVEC_LIB@ @LIBS@

LDFLAGS_PVFMM = $(LDLIBS_PVFMM) # Deprecated, use LDLIBS_PVFMM instead

# Add SCTL. The -DSCTL_HAVE_* flags below are filled in by configure (the
# SCTL_DEFS substitution; see configure.ac) based on the libraries it actually
# detected, so the SCTL layer only enables backends that are present.
# SCTL_PROFILE / SCTL_VERBOSE default in pvfmm_common.hpp (guarded by #ifndef);
# override e.g. with `make CXXFLAGS_PVFMM+=-DSCTL_PROFILE=0`.
CXXFLAGS_PVFMM += -DSCTL_HAVE_PVFMM @SCTL_DEFS@ @PVFMM_DEFS@
CXXFLAGS_PVFMM += -I$(TOP_SRCDIR_PVFMM)/SCTL/include
